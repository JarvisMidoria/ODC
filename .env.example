# Server-side only. Never prefix these credentials with VITE_.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=noreply@odyssee.ma
CONTACT_NOTIFICATION_TO=contact@odyssee.ma
# Production only: random secret authenticating the Vercel monthly test.
CRON_SECRET=
# Sanity configuration is provisioned by the Vercel integration.
SANITY_API_PROJECT_ID=ve9xrq77
SANITY_API_DATASET=production
SANITY_API_READ_TOKEN=
# Local import only; never use a VITE_ prefix for credentials.
SANITY_API_WRITE_TOKEN=
# Optional exact additional origin.
