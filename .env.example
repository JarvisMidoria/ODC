# Server-side only. Never prefix these credentials with VITE_.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=noreply@odyssee.ma
CONTACT_NOTIFICATION_TO=contact@odyssee.ma
# Optional exact additional origin.
CONTACT_SITE_ORIGIN=http://localhost:5173
# Preview/local connection check only: authenticates but never sends an email.
# Must be absent in production.
CONTACT_VERIFY_ONLY=1
