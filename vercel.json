{
  "headers": [
    { "source": "/admin/:path*", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin" }
    ] }
  ],
  "crons": [
    {
      "path": "/api/contact-monthly-test",
      "schedule": "0 8 1 * *"
    }
  ],
  "redirects": [
    { "source": "/admin.html", "destination": "/admin/", "permanent": false },
    { "source": "/admin-inbox", "destination": "/admin/", "permanent": false },
    { "source": "/admin-inbox/", "destination": "/admin/", "permanent": false },
    { "source": "/admin-inbox.html", "destination": "/admin/", "permanent": false },
    {
      "source": "/contacter",
      "destination": "/?contact=1",
      "permanent": false
    },
    {
      "source": "/contacter.html",
      "destination": "/?contact=1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    {
      "source": "/custom-assets/(.*)",
      "destination": "/public/custom-assets/$1"
    },
    {
      "source": "/fonts/(.*)",
      "destination": "/public/fonts/$1"
    },
    {
      "source": "/mirrored-styles/(.*)",
      "destination": "/public/mirrored-styles/$1"
    }
  ]
}
